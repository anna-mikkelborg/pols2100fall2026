head(data)
vars <- data.frame(
Variable = c(
"vvweight", "college", "medicare_expand",
"repeal_aca", "regulate_carbon", "prefertrump"
),
Description = c(
"Survey weight",
"Whether the person went to college (0 = no; 1 = yes)",
"Whether the person favors expanding Medicare, the medical program for people over 65 (0 = no; 1 = yes)",
"Whether the person favors repealing the Affordable Care Act, or \"Obamacare\" (0 = no; 1 = yes)",
"Whether the person favors regulations on carbon emissions (0 = no; 1 = yes)",
"Whether the person prefers Trump to win the 2020 presidential election (0 = no; 1 = yes)"
)
)
kable(vars, format = "html", col.names = c("Variable", "Description")) %>%
kable_styling(font_size = 18, full_width = FALSE) %>%
column_spec(1, monospace = TRUE, width = "4cm") %>%
column_spec(2, width = "11cm")
data <- read.csv("cces2020_pre.csv")
# How many people went to college in this dataset?
mean(data$college)
weighted.mean(data$college, data$vvweight)
weighted.mean(data$prefertrump, data$vvweight)
mean(data$prefertrump)
